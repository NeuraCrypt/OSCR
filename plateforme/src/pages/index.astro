---
import Base from "../layouts/Base.astro";
import { avecCode, catalogue, nomCourt, nombre, parJour, pluriel, slug, statut } from "../lib/catalogue";

const c = catalogue.chiffres;
const jours = parJour(avecCode);
let num = 0;
const scripts = (a: (typeof avecCode)[number]) => a.code.reduce((n, d) => n + d.lus, 0);
const cherche = (a: (typeof avecCode)[number]) => ({
  titre: a.titre.toLowerCase(),
  doi: a.doi.toLowerCase(),
  revue: a.revue.toLowerCase(),
  depot: a.code.map((d) => d.norme).join(" ").toLowerCase(),
});
---
<Base titre="Catalogue — Code natif" ariane={[{ texte: "Catalogue" }]}>
  <h1>Catalogue du code natif</h1>
  <p class="resume" id="resume">
    {pluriel(avecCode.length, "article")} avec le code de leurs auteurs, sur {nombre(c.articles)} lus ;{" "}
    {pluriel(c.depots_code, "dépôt")} de code, dont {nombre(c.depots_code_vivants)} vérifiés vivants.
  </p>

  {jours.map((j) => (
    <>
      <h2 class="jour">{j.libelle} <small>({pluriel(j.articles.length, "article")})</small></h2>
      <dl class="liste">
        {j.articles.map((a) => {
          num += 1;
          const s = statut(a.statut);
          const n = scripts(a);
          const k = cherche(a);
          return (
            <>
              <dt data-titre={k.titre} data-doi={k.doi} data-revue={k.revue} data-depot={k.depot}>
                <span class="num">[{num}]</span>{" "}
                <a href={`/article/${slug(a.id)}/`}>doi:{a.doi}</a>{" "}
                [<a href={`https://doi.org/${a.doi}`}>article</a>, <a href={`/article/${slug(a.id)}/#code`}>code</a>]
              </dt>
              <dd>
                <div class="titre">{a.titre}</div>
                <div class="ligne"><span class="etiquette">Revue&nbsp;:</span> {a.revue || "—"}</div>
                <div class="ligne">
                  <span class="etiquette">Code des auteurs&nbsp;:</span>{" "}
                  {a.code.map((d, i) => (
                    <>{i > 0 && ", "}<a class="code" href={d.url}>{nomCourt(d.norme)}</a> ({d.licence || "sans licence"})</>
                  ))}
                </div>
                <div class="ligne">
                  <span class="etiquette">Statut&nbsp;:</span>{" "}
                  {s.classe ? <span class={s.classe}>{s.libelle}</span> : s.libelle}
                  {n > 0 && <>, {pluriel(n, "fichier")} lisibles</>}
                  {a.carte?.doi && <>, carte validée par l'auteur (<a href={`https://doi.org/${a.carte.doi}`}>DOI</a>)</>}
                </div>
              </dd>
            </>
          );
        })}
      </dl>
    </>
  ))}
</Base>

<script>
  // La recherche du bandeau arrive ici par l'adresse (?q=…&champ=…) : on garde
  // les articles qui contiennent tous les mots, et les jours qui en ont encore.
  const params = new URLSearchParams(location.search);
  const q = (params.get("q") ?? "").trim();
  const champ = params.get("champ") ?? "tout";
  const formulaire = document.querySelector<HTMLFormElement>(".bandeau form");
  if (formulaire) {
    (formulaire.elements.namedItem("q") as HTMLInputElement).value = q;
    (formulaire.elements.namedItem("champ") as HTMLSelectElement).value = champ;
  }
  if (q) {
    const mots = q.toLowerCase().split(/\s+/);
    let trouves = 0;
    for (const dt of document.querySelectorAll<HTMLElement>("dl.liste dt")) {
      const d = dt.dataset;
      const texte = champ === "tout" ? `${d.titre} ${d.doi} ${d.revue} ${d.depot}` : (d[champ] ?? "");
      const garde = mots.every((m) => texte.includes(m));
      dt.hidden = !garde;
      (dt.nextElementSibling as HTMLElement).hidden = !garde;
      trouves += garde ? 1 : 0;
    }
    for (const liste of document.querySelectorAll<HTMLElement>("dl.liste")) {
      const restants = liste.querySelectorAll("dt:not([hidden])").length;
      const jour = liste.previousElementSibling as HTMLElement;
      liste.hidden = jour.hidden = restants === 0;
      jour.querySelector("small")!.textContent = `(${restants} article${restants > 1 ? "s" : ""})`;
    }
    document.getElementById("resume")!.textContent =
      `${trouves} article${trouves > 1 ? "s" : ""} pour « ${q} ». ` + (trouves ? "" : "Essayez un autre mot, ou tous les champs.");
  }
</script>
