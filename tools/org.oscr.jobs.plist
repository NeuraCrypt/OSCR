<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The site's requests (Phase 6, docs/CONTRIBUTIONS.md): every ten minutes, `oscr jobs poll` on the
  Cloudflare database reads the new rows of `jobs` in D1 community and answers them — a
  submission harvested into a draft, a correction applied as a new version, a map validated and
  deposited on Zenodo (the sandbox unless OSCR_ZENODO_INSTANCE=zenodo), a claim or a removal
  request listed for the owner (`oscr claims list`, `oscr reports list`).

  Installed by tools/install_mac.sh (one of its TASKS) since 2026-09-28.

  Its own task rather than a step of the harvester's loop: the watch spends up to 30 minutes in a
  slice of the stock, so a request would wait that long; here it waits at most ten. What it costs:
  144 polls a day, each one D1 query (the jobs after the last one seen: a few rows read, none
  when nothing is new) through wrangler's login or the REST API; an answer writes one row, in
  the facts push's daily budget (oscr/community.py).
  Template: tools/install_mac.sh replaces @ROOT@ and @LOGS@.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.oscr.jobs</string>

  <key>ProgramArguments</key>
  <array>
    <string>@ROOT@/.venv/bin/python</string>
    <string>-m</string>
    <string>oscr</string>
    <string>jobs</string>
    <string>poll</string>
    <string>--remote</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@ROOT@</string>

  <key>StartInterval</key>
  <integer>600</integer>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@LOGS@/jobs.log</string>
  <key>StandardErrorPath</key>
  <string>@LOGS@/jobs.log</string>
</dict>
</plist>
