.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# data/ is never versioned:
# - papers' full texts (the cache) are never published;
# - the working database keeps the sentences that made each link's verdict: it is
#   PRIVATE. Its copy WITHOUT excerpts is published in data/public/oscr_public.db;
# - benchmarks and their outputs are regenerated.
data/
# The website's public-API endpoints are SOURCE (they generate the /data/ static files at build
# time), not the private catalogue: keep them tracked despite the data/ rule above.
!website/src/pages/data/
!website/src/pages/data/**

# Generated outputs are not versioned: the catalogue lives on Hugging Face and on the
# website. The "git scraping" pattern (committing library/ and the mirror/ of scripts at
# each pass) only matters for the GitHub Actions harvest, which is dormant
# (.github/workflows/harvest.yml): the Mac harvests.
library/
mirror/

# The local configuration of the Claude app (website preview).
.claude/

# macOS folder metadata.
.DS_Store
