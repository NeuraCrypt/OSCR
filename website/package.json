{
  "name": "oscr-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The public website of the code registry (its name is set in src/config.ts): a static Astro site served by a Cloudflare Worker, built from the harvester's public export; the Worker's code (worker/) answers the search.",
  "scripts": {
    "data": "node scripts/data.mjs",
    "dev": "npm run data && astro dev",
    "build": "npm run data && astro build",
    "check": "node --experimental-strip-types scripts/check.mjs",
    "check:growth": "node --experimental-strip-types scripts/growth.mjs",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "highlight.js": "^11.12.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/svelte": "^9.0.1",
    "svelte": "^5.57.1",
    "wrangler": "^4.145.0"
  }
}
