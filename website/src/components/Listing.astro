---
// A list of papers, the catalogue's way (science.css): one h2.day per day of
// publication, then a dl.listing, one dt/dd per paper. The home page, the categories and
// the entity pages all use it. A paper without code (on request, data only) has no
// Code ↔ Paper reader: its status says what there is, in words. The markup is
// lib/render.ts's `listing`, the same the entity pages get in the browser.
import { rowOf, type Article } from "../lib/catalog";
import { listing } from "../lib/render";

interface Props {
  articles: Article[];
  /** The home page's filter reads these data-* attributes (its masthead search). */
  searchable?: boolean;
}
const { articles, searchable = false } = Astro.props;
---
<Fragment set:html={listing(articles.map(rowOf), { searchable })} />
