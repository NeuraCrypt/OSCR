---
// A string that may hold long addresses or paths ("https://doi.org/10.1016/j.x",
// "Figure3/analysis.m"): a line break is allowed (<wbr>) after a slash, "&", "?", "=" or
// "|", and inside any run of 24 characters that has none, so that it wraps on a phone
// instead of widening the page. A <wbr> only allows a break: the text itself, and what is
// copied, is unchanged. The rule is lib/render.ts's, shared with the pages rendered on demand.
import { wrapParts } from "../../lib/render";

interface Props {
  text: string;
}
const parts = wrapParts(Astro.props.text);
---
{parts.map((part, i) => <>{i > 0 && <wbr />}{part}</>)}
