---
// A string that may hold long addresses or paths ("https://doi.org/10.1016/j.x",
// "Figure3/analysis.m"): a line break is allowed (<wbr>) after a slash, "&", "?", "=" or
// "|", and inside any run of RUN characters that has none, so that it wraps on a phone
// instead of widening the page. A <wbr> only allows a break: the text itself, and what is
// copied, is unchanged.
interface Props {
  text: string;
}
const RUN = 24;
const text = Astro.props.text;
const parts: string[] = [];
let start = 0;
let run = 0;
for (let i = 0; i < text.length; i += 1) {
  const c = text[i];
  run = /\s/.test(c) ? 0 : run + 1;
  const after = "/&?=|".includes(c) && text[i + 1] !== "/" && i + 1 < text.length && !/\s/.test(text[i + 1]);
  // Never between the two halves of a character outside the BMP.
  const high = c >= "\ud800" && c <= "\udbff";
  if (!high && (after || run >= RUN)) {
    parts.push(text.slice(start, i + 1));
    start = i + 1;
    run = 0;
  }
}
parts.push(text.slice(start));
---
{parts.map((part, i) => <>{i > 0 && <wbr />}{part}</>)}
