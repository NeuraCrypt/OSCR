---
// The institutions of the authors, by ROR id. Few full texts carry ROR ids today; most
// will come with OpenAlex. The page exists even while the list is empty.
import Base from "../../layouts/Base.astro";
import { number, plural } from "../../lib/catalog";
import { institutionPages, institutions, institutionUrl, STATIC_MAX } from "../../lib/entities";

const sorted = [...institutionPages].sort((x, y) => x.name.localeCompare(y.name));
---
<Base
  title="Institutions"
  description="The institutions of the authors of the papers with their code, code on request or data only, by ROR id."
  breadcrumb={[{ text: "Browse", href: "/browse/" }, { text: "Institutions" }]}
>
  <h1>Institutions</h1>
  <p class="summary">
    Institutions come from the <a href="https://ror.org/">ROR</a> identifiers written in the authors' affiliations. Few
    full texts carry them; OpenAlex will add most of them. An institution is named after the affiliation most often
    written with its identifier.
  </p>
  {institutions.length === 0 ? (
    <p>No institution yet: no paper with a page has a ROR identifier in its affiliations.</p>
  ) : (
    <ul>
      {sorted.map((i) => (
        <li>
          <a href={institutionUrl(i.id)}>{i.name}</a> — {plural(i.counts.papers, "paper")}
          {i.counts.with_code > 0 && `, ${number(i.counts.with_code)} with code`}
        </li>
      ))}
    </ul>
  )}
  {institutions.length > institutionPages.length && (
    <p class="line">
      {plural(institutions.length - institutionPages.length, "other institution")} will have their page when pages are
      rendered on demand (beyond the first {number(STATIC_MAX.institution)}).
    </p>
  )}
</Base>
