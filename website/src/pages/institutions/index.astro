---
// The institutions of the authors, by ROR id: from the full texts that carry them, and from
// OpenAlex, which places most authors. The page exists even while the list is empty.
import Base from "../../layouts/Base.astro";
import { number, plural } from "../../lib/catalog";
import { countryName } from "../../lib/format";
import { institutions, institutionUrl } from "../../lib/entities";

const sorted = [...institutions].sort((x, y) => x.name.localeCompare(y.name));
---
<Base
  title="Institutions"
  description="The institutions of the authors of the papers with their code, code on request or data only, by ROR id."
  breadcrumb={[{ text: "Browse", href: "/browse/" }, { text: "Institutions" }]}
>
  <h1>Institutions</h1>
  <p class="summary">
    Institutions are identified by <a href="https://ror.org/">ROR</a>: from the authors' affiliations when the full
    text gives the identifier, and from <a href="https://openalex.org/">OpenAlex</a>, which names them and gives their
    country. An institution OpenAlex does not name is named after the affiliation most often written with its
    identifier.
  </p>
  {institutions.length === 0 ? (
    <p>No institution yet: no paper with a page has a ROR identifier in its affiliations.</p>
  ) : (
    <ul>
      {sorted.map((i) => (
        <li>
          <a href={institutionUrl(i.id)}>{i.name}</a>{countryName(i.country ?? "") && ` (${countryName(i.country ?? "")})`} —{" "}
          {plural(i.counts.papers, "paper")}
          {i.counts.with_code > 0 && `, ${number(i.counts.with_code)} with code`}
        </li>
      ))}
    </ul>
  )}
</Base>
