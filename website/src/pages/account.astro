---
// The account page (Phase 5). The page is static: its script (src/scripts/account.ts) asks the
// Worker who is signed in (/api/account/me) and shows one of the two parts below. Sign-in, sessions
// and verifications: website/worker/account/, docs/ACCOUNTS.md. science.css only.
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../config";

const providers = [
  { name: "orcid", label: "ORCID", why: "to be recognized as an author of your papers, through your ORCID iD" },
  { name: "github", label: "GitHub", why: "to be recognized as a maintainer of their code" },
  { name: "google", label: "Google", why: "to take part without either" },
];
---
<Base
  title="Account"
  description="Sign in with ORCID, GitHub or Google: be recognized as an author of your papers or a maintainer of their code."
  breadcrumb={[{ text: "Account" }]}
>
  <h1>Account</h1>
  <p id="account-message" role="status" aria-live="polite"></p>
  <noscript><p class="warning">The account page runs in your browser: it needs JavaScript.</p></noscript>

  <div id="signed-out">
    <p class="summary">
      Sign in to {SITE_NAME} to be recognized as an author of your papers, or as a maintainer of their code.
    </p>
    <ul id="sign-in">
      {providers.map((p) => (
        <li data-provider={p.name}>
          <a href={`/api/auth/${p.name}/start?return=/account/`}>Sign in with {p.label}</a>, {p.why}
        </li>
      ))}
    </ul>
    <p>
      One account can hold all three: once signed in, link the others from this page. The first sign-in creates the
      account; there is nothing else to fill in.
    </p>

    <h2>What signing in keeps</h2>
    <ul>
      <li>The name your provider gives, and your public identifiers: your ORCID iD, your GitHub login.</li>
      <li>
        No email address: ORCID and Google are asked for none, GitHub for no permission at all. Notifications, when they
        come, stay in the site.
      </li>
      <li>
        One cookie, for your session: a random number, of which {SITE_NAME} keeps only a fingerprint (its SHA-256).
        Sessions last 30 days; signing out ends yours at once.
      </li>
      <li>Nothing else from your provider: its access is used during the sign-in, then dropped.</li>
    </ul>
  </div>

  <div id="signed-in" hidden>
    <p class="summary">Signed in as <strong id="account-name"></strong>.</p>

    <h2>Your identities</h2>
    <ul id="identities"></ul>
    <p id="link-others" hidden>Link another: <span id="link-links"></span>.</p>

    <h2>Your roles</h2>
    <ul id="roles"></ul>

    <h2>Your papers</h2>
    <p id="papers-intro"></p>
    <ul id="papers"></ul>
    <form id="authorship-form" method="post" action="/api/account/authorship">
      <p><button type="submit">Check my papers again</button></p>
    </form>
    <p id="authorship-result" role="status" aria-live="polite"></p>

    <h2>Claim maintainership of a repository</h2>
    <p>
      The code repository of one of the papers {SITE_NAME} lists: on GitHub, you are its maintainer at once when you
      own it, belong publicly to the organization that owns it, or contributed to it. {SITE_NAME} asks GitHub, with
      your permission, and keeps only the answer. Otherwise, and for other forges, a moderator looks at your claim.
    </p>
    <form id="maintainer-form" method="post" action="/api/account/maintainer">
      <label for="repo">Repository</label>{" "}
      <input id="repo" name="repo" type="text" size="40" placeholder="https://github.com/owner/name" autocomplete="off"
        spellcheck="false" required />{" "}
      <button type="submit">Claim</button>
    </form>
    <p id="maintainer-result" role="status" aria-live="polite"></p>
    <h3>Your claims</h3>
    <p id="claims-none">None yet.</p>
    <ul id="claims"></ul>
    <p>
      An author of a paper whose metadata lacks your ORCID iD: claim it from the paper's own page, in its Contribute
      section.
    </p>

    <h2 id="submissions">Your submissions</h2>
    <p>
      <a href="/submit/">Submit a paper</a> and the links to its authors' code. {SITE_NAME} reads it and writes a draft of its
      record here: review it, correct the links if need be, then publish it.
    </p>
    <p id="submissions-none">None yet.</p>
    <div id="submissions-list"></div>
    <p id="submissions-result" role="status" aria-live="polite"></p>

    <h2 id="requests">Your corrections, validations and requests</h2>
    <h3>Corrections of records</h3>
    <p id="edits-none">None yet.</p>
    <ul id="edits"></ul>
    <h3>Validations of tracing maps</h3>
    <p id="validations-none">None yet.</p>
    <ul id="validations"></ul>
    <h3>Removal requests</h3>
    <p id="reports-none">None yet.</p>
    <ul id="reports"></ul>

    <h2 id="automation">Automation</h2>
    <p>
      <a href="/settings/tokens/">Personal tokens</a> for {SITE_NAME}'s <a href="/developers/">public API</a> (a script, a
      notebook, a lab's CI acting as you), and <a href="/settings/hooks/">webhooks</a> that post what happens to a paper or
      a repository to your own service.
    </p>

    <form id="signout-form" method="post" action="/api/account/signout">
      <p><button type="submit">Sign out</button></p>
    </form>
  </div>

  <script>
    import "../scripts/account";
  </script>
</Base>
