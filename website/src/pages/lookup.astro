---
// The DOI lookup (decision D2): any paper read can be found here, with or without a page.
// The page is static; the lookup runs in the reader's browser when the form is submitted
// (src/scripts/lookup.ts), and fetches one shard, /lookup/NN.json (256 at most).
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../config";
import { catalog, number } from "../lib/catalog";
---
<Base
  title="DOI lookup"
  description="Look up any paper the registry has read by its DOI, with or without a page, and see whether its authors' code was found."
  breadcrumb={[{ text: "DOI lookup" }]}
>
  <h1>DOI lookup</h1>
  <p class="summary">
    Enter a DOI to see whether {SITE_NAME} has read the paper and what it found. Every open-access neuroscience paper it
    has read can be looked up here, with or without a page ({number(catalog.figures.articles)} papers read in all).
  </p>
  <form id="lookup" action="/lookup/" method="get">
    <label for="doi">DOI</label>{" "}
    <input id="doi" name="doi" type="text" size="34" placeholder="10.1234/abcd" autocomplete="off" spellcheck="false"
      required />{" "}
    <button type="submit">Look up</button>
  </form>
  <p id="lookup-result" role="status" aria-live="polite"></p>
  <noscript><p class="warning">The lookup runs in your browser and needs JavaScript.</p></noscript>
  <p class="line">
    A paper has a page when its authors published their code, when its code is available on request, or when it shares
    its data only. Every other paper read can be found only here.
  </p>

  <script>
    import "../scripts/lookup";
  </script>
</Base>
