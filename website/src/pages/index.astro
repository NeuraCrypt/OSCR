---
// The home page: what the registry is, its figures (from the build's export, never written by
// hand), then the latest days of publication — whole days, up to HOME_PAPERS papers with their
// authors' code (lib/lists.ts) — and the ways to every older paper: the list by date (/list/),
// Browse, the search and the DOI lookup. It held every paper until 2026-09-29 (3.5 MB of HTML).
import Base from "../layouts/Base.astro";
import Listing from "../components/Listing.astro";
import { SITE_NAME, SITE_TAGLINE } from "../config";
import { catalog, number, plural, withCode, withPage } from "../lib/catalog";
import { dateInWords, dayInWords } from "../lib/format";
import { latestDays } from "../lib/lists";
import { HOME_PAPERS } from "../lib/shards";

const f = catalog.figures;
const matched = withCode.filter((a) => (a.alignment?.pairs ?? 0) > 0).length;
const latest = latestDays(withCode, HOME_PAPERS);
const oldest = latest.shown.at(-1)?.published ?? "";
const firstDayTotal = latest.cut ? withCode.filter((a) => a.published === latest.shown[0].published).length : 0;
const dayTotals = latest.cut ? new Map([[latest.shown[0].published, firstDayTotal]]) : undefined;
const pct = (x: number, y: number) => (y > 0 ? `${Math.round((100 * x) / y)}%` : "");
/** The word that goes with a figure shown apart from it. */
const w = (n: number, one: string, many: string) => (n === 1 ? one : many);
---
<Base breadcrumb={[{ text: "Catalogue" }]}>
  <h1>{SITE_TAGLINE}</h1>
  <p class="lead">
    {SITE_NAME} finds the code that the authors of open-access neuroscience papers published with their work. It reads
    each paper's own text for links to that code, checks at the source that every link answers, records the exact
    commit and its licence, and puts the code beside the paper in the Code&nbsp;↔&nbsp;Paper reader, which shows the
    lines of code that match each paragraph. It is free, it asks nobody for an email address, and the source always
    prevails.
  </p>
  <p class="lead">
    <a href="/about/">How it works, and why</a>
  </p>

  <dl class="figures" id="summary">
    <div><dt>{number(f.articles)}</dt><dd>open-access neuroscience {w(f.articles, "paper", "papers")} read</dd></div>
    <div>
      <dt>{number(withCode.length)}</dt>
      <dd>
        with their authors' code{f.research_articles > 0 && f.research_with_code > 0 &&
          `; ${pct(f.research_with_code, f.research_articles)} of the research articles have it`}
      </dd>
    </div>
    <div><dt>{number(f.repos_code)}</dt><dd>code {w(f.repos_code, "repository", "repositories")}, {number(f.repos_code_alive)} answering at the last check</dd></div>
    <div><dt>{number(f.scripts_read)}</dt><dd>{w(f.scripts_read, "script", "scripts")} read at the source</dd></div>
    {matched > 0 && (
      <div><dt>{number(matched)}</dt><dd>{w(matched, "paper", "papers")} with Code&nbsp;↔&nbsp;Paper matches ({plural(f.alignments, "match", "matches")})</dd></div>
    )}
  </dl>

  <h2 class="section">The latest papers with their authors' code</h2>
  <p class="summary">
    {latest.shown.length === 0
      ? "No paper with its authors' code yet."
      : latest.cut
        ? `The ${number(latest.shown.length)} first of the ${number(firstDayTotal)} papers published on ${dayInWords(latest.shown[0].published)}.`
        : latest.days === 1
          ? `The ${plural(latest.shown.length, "paper")} published on ${dayInWords(oldest)}, the latest day of the catalogue.`
          : `The ${plural(latest.shown.length, "paper")} of the catalogue's ${number(latest.days)} latest days of publication, from ${dateInWords(oldest)} to ${dateInWords(latest.shown[0].published)}.`}
    {" "}Every older paper is in <a href="/list/">the list by date</a>.
  </p>

  <Listing articles={latest.shown} dayTotals={dayTotals} />

  <h2 class="section" id="older">Older papers</h2>
  <ul>
    <li><a href="/list/">Every paper, by date</a>: the {plural(withPage.length, "paper")} with a page, {number(withCode.length)} of them with their authors' code, the others with code on request or data only.</li>
    <li><a href="/browse/">Browse</a> by category, author, journal, institution, tool or dataset.</li>
    <li><a href="/search/">Search</a> titles, authors, journals, tools, repositories and identifiers.</li>
    <li><a href="/lookup/">DOI lookup</a>: any paper read, with or without a page.</li>
  </ul>
</Base>
