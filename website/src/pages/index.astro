---
import Base from "../layouts/Base.astro";
import Listing from "../components/Listing.astro";
import { SITE_TAGLINE } from "../config";
import { catalog, number, plural, withCode } from "../lib/catalog";

const f = catalog.figures;
const matched = withCode.filter((a) => (a.alignment?.pairs ?? 0) > 0).length;
---
<Base breadcrumb={[{ text: "Catalogue" }]}>
  <h1>{SITE_TAGLINE}</h1>
  <p class="summary" id="summary">
    {plural(withCode.length, "paper")} with their authors' code, out of {number(f.articles)} open-access
    neuroscience papers read; {plural(f.repos_code, "code repository", "code repositories")},{" "}
    {number(f.repos_code_alive)} of them verified alive.
    {matched > 0 && ` Code\u00a0↔\u00a0Paper matches computed for ${plural(matched, "paper")}.`}
  </p>

  <Listing articles={withCode} searchable />

  <script>
    // The masthead search arrives here through the address (?q=…&field=…): the
    // papers that contain every word are kept, and the days that still have some.
    const FIELDS = ["all", "title", "doi", "journal", "repo"];
    const params = new URLSearchParams(location.search);
    const q = (params.get("q") ?? "").trim();
    const asked = params.get("field") ?? "all";
    const field = FIELDS.includes(asked) ? asked : "all";
    const form = document.querySelector<HTMLFormElement>(".masthead form");
    if (form) {
      (form.elements.namedItem("q") as HTMLInputElement).value = q;
      (form.elements.namedItem("field") as HTMLSelectElement).value = field;
    }
    const papers = (n: number) => `${n.toLocaleString("en-GB")} paper${n === 1 ? "" : "s"}`;
    if (q) {
      const words = q.toLowerCase().split(/\s+/);
      let found = 0;
      for (const dt of document.querySelectorAll<HTMLElement>("dl.listing dt")) {
        const d = dt.dataset;
        const text = field === "all" ? `${d.title} ${d.doi} ${d.journal} ${d.repo}` : (d[field] ?? "");
        const keep = words.every((w) => text.includes(w));
        dt.hidden = !keep;
        (dt.nextElementSibling as HTMLElement).hidden = !keep;
        found += keep ? 1 : 0;
      }
      for (const list of document.querySelectorAll<HTMLElement>("dl.listing")) {
        const left = list.querySelectorAll("dt:not([hidden])").length;
        const day = list.previousElementSibling as HTMLElement;
        list.hidden = day.hidden = left === 0;
        day.querySelector("small")!.textContent = `(${papers(left)})`;
      }
      document.getElementById("summary")!.textContent =
        `${papers(found)} for “${q}”.` + (found ? "" : " Try another word, or all fields.");
    }
  </script>
</Base>
