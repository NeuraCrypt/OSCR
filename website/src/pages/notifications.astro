---
// /notifications/: the in-site inbox (night phase 08, E5; docs/SOCIAL.md). In the site only: no email
// is ever sent (D5). Its script (src/scripts/notifications.ts) reads GET /api/forge/social/inbox when
// the reader is signed in (1 request), filters and switches views in the browser.
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../config";
---
<Base
  title="Notifications"
  description="Your notifications: the repositories and papers you watch, the conversations you take part in, where you are mentioned. They appear in the site only, and no email is ever sent."
  breadcrumb={[{ text: "Notifications" }]}
>
  <div id="notifications-shell" data-site={SITE_NAME}>
    <h1>Notifications</h1>
    <p class="summary" aria-live="polite">Reading your notifications…</p>
    <noscript><p class="warning">This page reads your notifications in your browser, which needs JavaScript.</p></noscript>
    <p>{SITE_NAME}'s notifications appear only in this site. {SITE_NAME} never sends an email and never asks for an email address.</p>
  </div>
  <script>
    import "../scripts/notifications";
  </script>
</Base>
