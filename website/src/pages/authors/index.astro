---
// The authors with an ORCID iD, by family name: the letters here, each letter's authors on a page
// of its own (/authors/<letter>/), so that the list stays light however many they are. Names
// without an ORCID iD cannot be merged reliably across papers: they stay names on the pages of
// their papers.
import Base from "../../layouts/Base.astro";
import { plural } from "../../lib/catalog";
import { authorLetters, authors } from "../../lib/entities";
---
<Base
  title="Authors"
  description="The authors, with an ORCID iD, of the papers with their code, code on request or data only."
  breadcrumb={[{ text: "Browse", href: "/browse/" }, { text: "Authors" }]}
>
  <h1>Authors</h1>
  <p class="summary">
    {plural(authors.length, "author")} with an ORCID iD, on the papers with a page, by family name. An author without an
    ORCID iD stays a name on the pages of their papers: names alone cannot be merged reliably from one paper to another.
  </p>
  {authors.length === 0 ? (
    <p>No author with an ORCID iD yet: they come with the enrichment of the papers.</p>
  ) : (
    <ul>
      {authorLetters.map((g) => (
        <li id={`letter-${g.letter}`}><a href={`/authors/${g.slug}/`}>{g.letter}</a>, {plural(g.authors.length, "author")}</li>
      ))}
    </ul>
  )}
</Base>
