---
// Request a removal (Phase 6; decided 2026-09-29): one static page for every record, reached as
// /removal/?paper=<the registry's id or a DOI> from each paper's page ("Request removal", in its
// sidebar and its Contribute section). Its script (src/scripts/removal.ts) reads the paper's facts
// from the site's own files (its record, or the top of its static page: src/lib/removal.ts), asks the
// Worker who is signed in only when the browser holds a session, and runs the request in three
// steps: the form, its review ("Confirm and send": nothing is sent before), the receipt. Revisited,
// the page shows the request's state and the moderator's words. The rules of a request (who asks,
// what to remove, why, the justification, the evidence, the two confirmations) are the Worker's own
// (POST /api/reports). One page, never one per paper (CLAUDE.md, the file budget). science.css only.
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../config";
import { DETAILS_MAX, DETAILS_MIN, EVIDENCE_MAX, NIGHTLY, REASONS, ROLES, SCOPES } from "../lib/removal";

const providers = [
  { name: "orcid", label: "ORCID", why: ": an author of the paper is recognized at once, by their ORCID iD" },
  { name: "github", label: "GitHub", why: "" },
  { name: "google", label: "Google", why: "" },
];
const choice = (group: string, value: string) => `${group}-${value.replace(/_/g, "-")}`;
---
<Base
  title="Request a removal"
  description="Ask for a paper's record, the copies of its authors' scripts or its tracing map to be removed: signed in, justified, decided by published rules."
  breadcrumb={[{ text: "Request a removal" }]}
>
  <h1>Request a removal</h1>
  <p class="summary">
    Ask {SITE_NAME} to remove a paper's record, the copies it keeps of the authors' scripts (or their display from their
    source), or the paper's tracing map. Published rules decide every request, and the operator reviews what they cannot
    decide: there is no human moderator on duty at the moment (<a href="/policies/moderation/">how requests are decided</a>).
  </p>
  <noscript><p class="warning">This page runs in your browser: it needs JavaScript.</p></noscript>
  <p id="removal-message" role="status" aria-live="polite"></p>

  <section id="removal-paper" aria-labelledby="removal-paper-title">
    <h2 id="removal-paper-title">The record</h2>
    <div id="removal-facts"><p class="muted">Reading the record…</p></div>
    <form id="removal-find" method="get" action="/removal/" hidden>
      <p><label for="removal-find-paper">The paper's DOI</label><br />
        <input id="removal-find-paper" name="paper" type="text" size="34" placeholder="10.1234/abcd" autocomplete="off"
          spellcheck="false" required />{" "}
        <button type="submit">Open</button></p>
    </form>
  </section>

  <section id="removal-signed-out" aria-labelledby="removal-sign-in-title" hidden>
    <h2 id="removal-sign-in-title">Sign in to request its removal</h2>
    <p>
      A removal request is made signed in: the decision comes back to this page and to your account page, with no email
      address asked for or sent. Signed in with the ORCID iD the paper lists, you are recognized as its author, and your
      request is applied without waiting.
    </p>
    <ul id="removal-sign-in">
      {providers.map((p) => (
        <li><a data-provider={p.name} href={`/api/auth/${p.name}/start?return=/removal/`}>Sign in with {p.label}</a>{p.why}</li>
      ))}
    </ul>
    <p>You come back to this page once signed in.</p>
  </section>

  <div id="removal-signed-in" hidden>
    <p id="removal-who"></p>

    <section id="removal-request" aria-labelledby="removal-request-title" hidden>
      <h2 id="removal-request-title" tabindex="-1">Your request</h2>
      <p id="removal-request-state"></p>
      <dl class="review" id="removal-request-summary"></dl>
      <p id="removal-request-next"></p>
    </section>

    <form id="removal-form" method="post" action="/api/reports" novalidate hidden>
      <h2 id="removal-form-title">Your request</h2>
      <p class="summary">Step 1 of 2: what you ask. You review it before anything is sent.</p>

      <fieldset id="removal-role">
        <legend>Who you are</legend>
        <ul class="choices">
          {ROLES.map(([value, text]) => (
            <li>
              <input type="radio" name="role" id={choice("role", value)} value={value} />
              <label for={choice("role", value)}>{text}</label>
              {value === "author" && <> <span id="removal-author-note"></span></>}
            </li>
          ))}
        </ul>
      </fieldset>

      <fieldset id="removal-scope">
        <legend>What to remove</legend>
        <ul class="choices">
          {SCOPES.map(([value, text]) => (
            <li>
              <input type="radio" name="scope" id={choice("scope", value)} value={value} />
              <label for={choice("scope", value)}>{text}</label>
              {value === "repository" && (
                <div class="detail" id="removal-repo-detail" hidden>
                  <label for="removal-repo">Repository</label>{" "}
                  <select id="removal-repo" name="repo"></select>
                </div>
              )}
              {value === "file" && (
                <div class="detail" id="removal-file-detail" hidden>
                  <p><label for="removal-file-repo">Repository</label>{" "}
                    <select id="removal-file-repo" name="file_repo"></select></p>
                  <p><label for="removal-file">File</label>{" "}
                    <select id="removal-file" name="path"></select></p>
                  <p id="removal-file-more" class="summary" hidden></p>
                </div>
              )}
            </li>
          ))}
        </ul>
        <p id="removal-scope-note" class="summary" hidden></p>
      </fieldset>

      <fieldset id="removal-reason">
        <legend>Why</legend>
        <ul class="choices">
          {REASONS.map(([value, text]) => (
            <li>
              <input type="radio" name="reason" id={choice("reason", value)} value={value} />
              <label for={choice("reason", value)}>{text}</label>
            </li>
          ))}
        </ul>
        <p id="removal-incorrect" class="warning" hidden>
          A wrong link, or a link given the wrong role, can be corrected rather than removed: the paper's verified authors and
          the maintainers of its code <a id="removal-correct" href="/lookup/">correct its record</a> from its page, and the
          correction becomes a new version of the record. You may still ask for its removal here.
        </p>
      </fieldset>

      <p>
        <label for="removal-details">Justification</label>{" "}
        <span class="muted">— what is wrong, and where; {DETAILS_MIN} to {DETAILS_MAX.toLocaleString("en-GB")} characters; no email address</span><br />
        <textarea id="removal-details" name="details" rows="7" maxlength={DETAILS_MAX * 2} aria-describedby="removal-details-count"></textarea><br />
        <span id="removal-details-count" class="muted" aria-live="polite"></span>
      </p>
      <p>
        <label for="removal-evidence">A link to evidence</label>{" "}
        <span class="muted">— optional; a web page that starts with https://</span><br />
        <input id="removal-evidence" name="evidence_url" type="text" inputmode="url" maxlength={EVIDENCE_MAX} placeholder="https://"
          autocomplete="off" spellcheck="false" />
      </p>

      <fieldset id="removal-confirm">
        <legend>Confirmations</legend>
        <ul class="choices">
          <li>
            <input type="checkbox" id="removal-confirm-accurate" name="confirm_accurate" />
            <label for="removal-confirm-accurate">The information I give is accurate.</label>
          </li>
          <li>
            <input type="checkbox" id="removal-confirm-review" name="confirm_review" />
            <label for="removal-confirm-review">
              I understand how requests are decided (<a href="/policies/moderation/">the moderation policy</a>) and what can
              follow: the rules may apply the request at once, hide copies at once pending review, or leave it to the
              operator, who may accept it, in whole or in part, refuse it or reverse what the rules did, with their words;
              accepted, the removal takes effect at the next nightly publication.
            </label>
          </li>
        </ul>
      </fieldset>

      <p id="removal-form-error" class="warning" role="alert" hidden></p>
      <p><button type="submit">Review the request</button></p>
    </form>

    <section id="removal-review" aria-labelledby="removal-review-title" hidden>
      <h2 id="removal-review-title" tabindex="-1">Review your request</h2>
      <p class="summary">Step 2 of 2: nothing has been sent yet. Check what you ask, then confirm.</p>
      <dl class="review" id="removal-review-summary"></dl>
      <p id="removal-review-error" class="warning" role="alert" hidden></p>
      <p><button type="button" id="removal-send">Confirm and send</button>{" "}
        <button type="button" id="removal-back">Back to the form</button></p>
    </section>

    <section id="removal-receipt" aria-labelledby="removal-receipt-title" hidden>
      <h2 id="removal-receipt-title" tabindex="-1">Request received</h2>
      <p id="removal-receipt-state"></p>
      <dl class="review" id="removal-receipt-summary"></dl>
      <p id="removal-receipt-next"></p>
    </section>
  </div>

  <h2>What happens to a request</h2>
  <ol>
    <li>
      {SITE_NAME}'s machine reads it within about ten minutes and applies its published rules
      (<a href="/policies/moderation/">the moderation policy</a>): a request from a verified author of the paper (your ORCID
      iD among its authors), or from a maintainer of the code it names (its owner, or a public member of its organization, on
      GitHub), is applied without waiting; the copies of the
      authors' code are hidden at once for copyright or personal data, pending review; any other request waits for the
      operator, 30 days at most, and nothing is removed meanwhile. There is no human moderator on duty at the moment: a
      request no one decided in 30 days is closed without removal, and may be asked again in a way the rules decide.
    </li>
    <li>Accepted, what it names leaves {SITE_NAME} at the next nightly publication, at {NIGHTLY} (the registry's local time):
      its pages, its search, its DOI lookup and its open data. A whole record leaves every page; the copies of the authors'
      scripts leave, and are no longer shown from their source, and their links to the source stay; a tracing map leaves
      with its matches and its validation.</li>
    <li>Refused, the decision says why. Either way it shows on this page and on{" "}
      <a href="/account/#removals">your account page</a>: no email is sent.</li>
  </ol>

  <h2>What is kept</h2>
  <ul>
    <li>Your request, with your account: who you are, what you ask to remove and why, your justification and your evidence
      link, the decision and the rule that made it.</li>
    <li>No email address: a justification that holds one is refused.</li>
    <li>One request per account and record, which you may complete while it is open, and ask again once refused only in a way
      the rules decide at once; ten requests a day at most.</li>
  </ul>

  <script>
    import "../scripts/removal";
  </script>
</Base>
