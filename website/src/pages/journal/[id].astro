---
// A journal: its identifiers, how many of the papers read in it have their authors' code,
// and its papers with a page.
import Base from "../../layouts/Base.astro";
import Listing from "../../components/Listing.astro";
import { number, plural } from "../../lib/catalog";
import { journalPages, papersOf, type Journal } from "../../lib/entities";

export function getStaticPaths() {
  return journalPages.map((j) => ({ params: { id: j.slug }, props: { j } }));
}

const { j } = Astro.props as { j: Journal };
const papers = papersOf(j.papers);
const others = j.counts.papers - j.counts.with_code;
---
<Base
  title={j.title}
  description={`The papers of ${j.title} with their code, code on request or data only.`}
  breadcrumb={[{ text: "Browse", href: "/browse/" }, { text: "Journals", href: "/journals/" }, { text: j.title }]}
>
  <h1>{j.title}</h1>
  <p class="summary">
    {plural(j.counts.with_code, "paper")} with their authors' code out of {plural(j.counts.read, "paper")} read in this
    journal{others > 0 && `; ${number(others)} more with code on request or data only`}.
  </p>
  <div class="line"><span class="label">ISSN:</span> {j.issn || "—"}</div>
  <div class="line"><span class="label">eISSN:</span> {j.eissn || "—"}</div>
  <div class="line"><span class="label">Publisher:</span> {j.publisher || "—"}</div>

  <h2>Papers</h2>
  <Listing articles={papers} />
</Base>
