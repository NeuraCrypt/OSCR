---
// The page of a paper (decision D2): a paper with its authors' code, or whose code is on
// request, or which shares its data only. Its sections are those of one page, reached
// through a bar of in-page links (#overview, #code, …): no JavaScript and no route of their
// own. What they show beyond catalog.json comes from src/data/papers/ (oscr/paperpage.py);
// the Code ↔ Paper reader stays at /paper/<slug>/code/. Built for the most recent papers only.
import Base from "../../../layouts/Base.astro";
import Code from "../../../components/paper/Code.astro";
import Cite from "../../../components/paper/Cite.astro";
import Contribute from "../../../components/paper/Contribute.astro";
import Data from "../../../components/paper/Data.astro";
import Later from "../../../components/paper/Later.astro";
import Overview from "../../../components/paper/Overview.astro";
import Similar from "../../../components/paper/Similar.astro";
import TracingMap from "../../../components/paper/TracingMap.astro";
import Versions from "../../../components/paper/Versions.astro";
import Wrap from "../../../components/paper/Wrap.astro";
import {
  alignmentOf, dateInWords, europePmcUrl, plural, readerUrl, shortName, staticPages, status, type Article,
} from "../../../lib/catalog";
import { datasetOf } from "../../../lib/entities";
import { licenseLabel, NOTICES, pageOf, PROMINENT } from "../../../lib/paper";

// The STATIC_PAPERS most recent papers (lib/shards.ts); the others' pages are rendered on demand
// by the Worker (worker/pages.ts), from src/pages/records/.
export function getStaticPaths() {
  return staticPages.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: Article };
const p = pageOf(a);
const s = status(a.status);
const hasCode = a.code.length > 0;
const pairs = alignmentOf(a)?.pairs ?? [];
const reader = readerUrl(a);
const validated = a.card && a.card.validated_by?.length ? a.card : null;
const licenses = [...new Set(a.code.map((r) => r.license || "no license"))];
// Retractions, expressions of concern, corrections: said before anything else.
const notices = (p?.overview.notices ?? []).filter((n) => PROMINENT.has(n.kind));
/** A dataset in the sidebar: "OpenNeuro ds000117", "DANDI 000001". */
const data = (a.datasets ?? []).map((id) => ({ id, d: datasetOf(id) })).filter((x) => x.d?.url);
const dataLabel = (id: string, repository: string) => (repository ? `${repository} ${id.replace(/^[a-z0-9-]+:/i, "")}` : id);
const SECTIONS = [
  { id: "overview", label: "Overview" },
  { id: "code", label: "Code" },
  { id: "map", label: "Map" },
  { id: "data", label: "Data" },
  { id: "versions", label: "Versions" },
  { id: "cite", label: "Cite" },
  { id: "similar", label: "Similar" },
  { id: "contribute", label: "Contribute" },
  { id: "discussion", label: "Discussion" },
  { id: "reproductions", label: "Reproductions" },
  { id: "activity", label: "Activity" },
];
/** The sections that open with sign-in (Phase 7): muted in the bar. */
const LATER = new Set(["discussion", "reproductions", "activity"]);
---
<Base
  title={a.title}
  description={hasCode ? `The code published by the authors of “${a.title}”.` : `“${a.title}”: ${s.label}.`}
  breadcrumb={[{ text: "Catalogue", href: "/" }, { text: `doi:${a.doi}` }]}
>
  <div class="record">
    <div class="body">
      <h1><Wrap text={a.title} /></h1>
      {notices.map((n) => (
        <p class="warning">
          <strong>{NOTICES[n.kind]}</strong>{n.date && ` (${dateInWords(n.date)})`}:{" "}
          {n.url ? <a href={n.url}>the notice{n.id && `, ${n.id}`}</a> : `the notice ${n.id}`.trim()}
          {n.source && `, from ${n.source}`}.
        </p>
      ))}
      {/* The sections of the page: a ruled bar of in-page links (nav.tabs, science.css). */}
      <nav class="tabs" aria-label="Sections of this page">
        <ul>{SECTIONS.map((x) => <li class={LATER.has(x.id) ? "later" : undefined}><a href={`#${x.id}`}>{x.label}</a></li>)}</ul>
      </nav>

      <Overview a={a} p={p} />
      <Code a={a} p={p} />
      <TracingMap a={a} p={p} />
      <Data a={a} p={p} />
      <Versions p={p} />
      <Cite a={a} p={p} />
      <Similar p={p} />
      <Contribute a={a} p={p} />
      <Later />
    </div>

    <aside class="sidebar">
      {hasCode && (
        <>
          <h3><a class="reader-link" href={reader}>Code ↔ Paper</a></h3>
          <ul>
            <li>the paper and its authors' code, side by side</li>
            <li>{pairs.length > 0 ? `${plural(pairs.length, "match", "matches")} between paragraphs and code` : "matches not computed yet"}</li>
          </ul>
        </>
      )}
      <h3>Access</h3>
      <ul>
        <li><a href={`https://doi.org/${a.doi}`}>The paper, at the publisher</a></li>
        <li><a href={europePmcUrl(a)}>The paper on Europe PMC</a></li>
        {a.code.map((r) => <li><a href={r.url}><Wrap text={shortName(r)} /></a></li>)}
        <li><a href="#cite">Cite this paper</a></li>
      </ul>
      {data.length > 0 && (
        <>
          <h3>Data</h3>
          <ul>{data.map((x) => <li><a href={x.d!.url}><Wrap text={dataLabel(x.id, x.d!.repository)} /></a></li>)}</ul>
        </>
      )}
      {hasCode && (
        <>
          <h3>Tracing map</h3>
          <ul>
            <li>{validated ? "validated by an author" : "proposed by the machine"}</li>
            <li>{validated?.doi ? <a href={`https://doi.org/${validated.doi}`}>its DOI</a> : "no DOI before an author validates it"}</li>
          </ul>
          <h3>Licenses</h3>
          <ul>
            {p && <li>the paper: {licenseLabel(p.overview.license) || "none stated"}</li>}
            {licenses.map((l) => <li>{p ? `the code: ${l}` : l}</li>)}
          </ul>
        </>
      )}
      {!hasCode && p && (
        <>
          <h3>License</h3>
          <ul><li>the paper: {licenseLabel(p.overview.license) || "none stated"}</li></ul>
        </>
      )}
      <h3>This record</h3>
      <ul>
        <li><a href="#contribute">Claim it, correct it{hasCode ? ", validate its map" : ""}</a></li>
        <li><a href="#removal">Request its removal</a></li>
      </ul>
    </aside>
  </div>
</Base>
