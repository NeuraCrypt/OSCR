---
// An author with an ORCID iD: their latest affiliations, the tools of their papers'
// code, and their papers with a page.
import Base from "../../layouts/Base.astro";
import Listing from "../../components/Listing.astro";
import { number, plural } from "../../lib/catalog";
import {
  authorPages, institutionOf, institutionUrl, orcidUrl, papersOf, toolOf, toolUrl, type Author,
} from "../../lib/entities";

export function getStaticPaths() {
  return authorPages.map((a) => ({ params: { orcid: a.orcid }, props: { a } }));
}

const { a } = Astro.props as { a: Author };
const papers = papersOf(a.papers);
const places = a.institutions.map((id) => ({ id, name: institutionOf(id)?.name ?? id, url: institutionUrl(id) }));
const tools = a.tools.map((id) => ({ id, name: toolOf(id)?.name ?? id, url: toolUrl(id) }));
---
<Base
  title={a.name}
  description={`The papers of ${a.name} with their code, code on request or data only.`}
  breadcrumb={[{ text: "Browse", href: "/browse/" }, { text: "Authors", href: "/authors/" }, { text: a.name }]}
>
  <h1>{a.name}</h1>
  <p class="summary">
    {plural(a.counts.papers, "paper")} with a page, {number(a.counts.with_code)} of them with the authors' code.
  </p>
  <div class="line"><span class="label">ORCID iD:</span> <a href={orcidUrl(a.orcid)}>{orcidUrl(a.orcid)}</a></div>
  {/* Night phase 08: follow this author by their ORCID iD, before they have an account (social-buttons.ts);
      their profile in the registry, once they have one. */}
  <div data-social data-target={`orcid:${a.orcid}`} data-label={a.name} data-watch="person"></div>
  <div class="line"><a href={`/u/${a.orcid}/`}>Their profile and activity in the registry</a></div>
  {a.affiliations.length > 0 && (
    <div class="line"><span class="label">Latest affiliations:</span> {a.affiliations.join("; ")}</div>
  )}
  {places.length > 0 && (
    <div class="line">
      <span class="label">Institutions:</span>{" "}
      {places.map((p, i) => <>{i > 0 && ", "}{p.url ? <a href={p.url}>{p.name}</a> : p.name}</>)}
    </div>
  )}
  {tools.length > 0 && (
    <div class="line">
      <span class="label">Tools in the code of their papers:</span>{" "}
      {tools.map((t, i) => <>{i > 0 && ", "}{t.url ? <a href={t.url}>{t.name}</a> : t.name}</>)}
    </div>
  )}

  <h2>Papers</h2>
  <Listing articles={papers} />
  <script>
    import "../../scripts/social-buttons";
  </script>
</Base>
