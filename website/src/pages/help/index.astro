---
// Help: the index of the guides (src/lib/info.ts HELP), grouped as arXiv's help is, with a short
// summary of each; the frequent questions are on /help/faq/.
import Info from "../../components/Info.astro";
import { SITE_NAME } from "../../config";
import { HELP } from "../../lib/info";

const by = (hrefs: string[]) => hrefs.map((h) => HELP.find((l) => l.href === h)!).filter(Boolean);
const groups = [
  { id: "finding", title: "Finding and reading", links: by(["/help/search/", "/help/paper/", "/help/reader/", "/help/maps/"]) },
  { id: "account", title: "Your account", links: by(["/help/accounts/"]) },
  {
    id: "contributing",
    title: "Contributing",
    links: by(["/help/submit/", "/help/correct/", "/help/claim/", "/help/validate/", "/help/badge/", "/help/removal/"]),
  },
  { id: "data", title: "Data and questions", links: by(["/help/data/", "/help/faq/"]) },
];
---
<Info
  title="Help"
  description={`How to search ${SITE_NAME}, read a paper's page and its Code ↔ Paper reader, sign in, contribute, and use the data.`}
  group="help"
  path="/help/"
>
  <p class="lead" slot="lead">
    Guides to every part of {SITE_NAME}: finding papers and their code, reading them side by side, and — for authors
    and maintainers — correcting, validating and citing their records. No account is needed to read anything; signing
    in is only for contributing, and asks for no email address.
  </p>

  {groups.map((g) => (
    <>
      <h2 id={g.id}>{g.title}</h2>
      <dl class="index">
        {g.links.map((l) => (
          <>
            <dt><a href={l.href}>{l.text}</a></dt>
            <dd>{l.summary}</dd>
          </>
        ))}
      </dl>
    </>
  ))}

  <h2 id="start">Where to start</h2>
  <ul>
    <li>Looking for a paper's code? Type its DOI, title or a word into the search box at the top of every page, or use
      the <a href="/lookup/">DOI lookup</a>, which answers for every paper {SITE_NAME} has read.</li>
    <li>Browsing? The home page lists the latest papers with code; <a href="/list/">every paper by date</a>,{" "}
      <a href="/browse/">the categories</a> and the lists of authors, journals, institutions, tools and datasets list
      the rest.</li>
    <li>An author? Sign in with ORCID on <a href="/account/">your account page</a>: the papers that list your ORCID iD
      appear there, and each one's page lets you correct it, validate its map and add the badge.</li>
    <li>Something wrong or unwanted? Correct it from the paper's page, or <a href="/help/removal/">ask for its
      removal</a>.</li>
  </ul>
</Info>
