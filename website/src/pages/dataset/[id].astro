---
// A dataset: where it is held, and the papers with a page that cite it.
import Base from "../../layouts/Base.astro";
import Listing from "../../components/Listing.astro";
import { number, plural } from "../../lib/catalog";
import { datasetName, datasetPages, papersOf, type Dataset } from "../../lib/entities";

export function getStaticPaths() {
  return datasetPages.map((d) => ({ params: { id: d.slug }, props: { d } }));
}

const { d } = Astro.props as { d: Dataset };
const papers = papersOf(d.papers);
const name = datasetName(d);
---
<Base
  title={name}
  description={`The papers that cite the dataset ${d.id}.`}
  breadcrumb={[{ text: "Browse", href: "/browse/" }, { text: "Datasets", href: "/datasets/" }, { text: d.id }]}
>
  <h1>{name}</h1>
  <p class="summary">
    Cited by {plural(d.counts.papers, "paper")} with a page, {number(d.counts.with_code)} of them with the authors' code.
  </p>
  <div class="line"><span class="label">Identifier:</span> <span class="code">{d.id}</span></div>
  {d.repository && <div class="line"><span class="label">Repository:</span> {d.repository}</div>}
  {d.url && <div class="line"><span class="label">Link:</span> <a href={d.url}>{d.url}</a></div>}
  {d.license && <div class="line"><span class="label">License:</span> {d.license}</div>}

  <h2>Papers</h2>
  <Listing articles={papers} />
</Base>
