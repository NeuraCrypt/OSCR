---
// The tools found in the authors' code (the imports of their scripts), the most used first.
import Base from "../../layouts/Base.astro";
import { plural } from "../../lib/catalog";
import { tools, toolUrl } from "../../lib/entities";
---
<Base
  title="Tools"
  description="The libraries, toolboxes and software found in the code of the papers' authors."
  breadcrumb={[{ text: "Browse", href: "/browse/" }, { text: "Tools" }]}
>
  <h1>Tools</h1>
  <p class="summary">
    {plural(tools.length, "tool")} found in the authors' code of the papers with a page, the most used first. A tool
    is found in the scripts of the authors' repositories (what they import), not in the text of the paper.
  </p>
  {tools.length === 0 && <p>No tool yet: they are found when the repositories are described.</p>}
  <ul>
    {tools.map((t) => (
      <li>
        <a href={toolUrl(t.id)}>{t.name}</a>{t.kind && ` (${t.kind})`}, {plural(t.counts.papers, "paper")},{" "}
        {plural(t.counts.repositories, "repository", "repositories")}
      </li>
    ))}
  </ul>
</Base>
