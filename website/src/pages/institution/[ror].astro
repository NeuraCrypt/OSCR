---
// An institution, by ROR id: its authors with an ORCID iD and its papers with a page.
import Base from "../../layouts/Base.astro";
import Listing from "../../components/Listing.astro";
import { number, plural } from "../../lib/catalog";
import { countryName } from "../../lib/format";
import { authorOf, authorUrl, institutionPages, papersOf, rorUrl, type Institution } from "../../lib/entities";

export function getStaticPaths() {
  return institutionPages.map((i) => ({ params: { ror: i.id }, props: { i } }));
}

const { i } = Astro.props as { i: Institution };
const country = countryName(i.country ?? "");
const papers = papersOf(i.papers);
const people = i.authors
  .map((orcid) => ({ orcid, name: authorOf(orcid)?.name ?? orcid, url: authorUrl(orcid) }))
  .sort((x, y) => x.name.localeCompare(y.name));
---
<Base
  title={i.name}
  description={`The papers of authors at ${i.name} with their code, code on request or data only.`}
  breadcrumb={[{ text: "Browse", href: "/browse/" }, { text: "Institutions", href: "/institutions/" }, { text: i.name }]}
>
  <h1>{i.name}</h1>
  <p class="summary">
    {plural(i.counts.papers, "paper")} with a page by authors affiliated with this institution,{" "}
    {number(i.counts.with_code)} of them with the authors' code.
  </p>
  <div class="line"><span class="label">ROR:</span> <a href={rorUrl(i.id)}>{rorUrl(i.id)}</a></div>
  {(country || i.type) && (
    <div class="line">
      {country && <><span class="label">Country:</span> {country}</>}{country && i.type && " · "}
      {i.type && <><span class="label">Type:</span> {i.type}</>}
    </div>
  )}
  {people.length > 0 && (
    <div class="line">
      <span class="label">Authors with an ORCID iD:</span>{" "}
      {people.map((p, n) => <>{n > 0 && ", "}{p.url ? <a href={p.url}>{p.name}</a> : p.name}</>)}
    </div>
  )}

  <h2>Papers</h2>
  <Listing articles={papers} />
</Base>
