---
// The main layout. science.css is the ONLY source of style of the site, and it is
// imported here only. The name of the platform comes from src/config.ts, and only
// from there.
import "../styles/science.css";
import { SITE_NAME, SITE_TAGLINE, TURNSTILE_SITE_KEY } from "../config";
import { catalog, generatedInWords } from "../lib/catalog";

interface Props {
  /** The title of the page, without the platform's name (added here). None on the home page. */
  title?: string;
  description?: string;
  /** The breadcrumb after the platform's name; the last item has no link. `id`: a page whose
   *  script renders it names its last item (the pages rendered on demand). */
  breadcrumb?: { text: string; href?: string; id?: string }[];
}
const {
  title,
  description = "The code published by the authors of open-access neuroscience papers: found in the paper, verified at the source.",
  breadcrumb = [],
} = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : SITE_TAGLINE === SITE_NAME ? SITE_NAME : `${SITE_NAME} — ${SITE_TAGLINE}`;
// The ways in besides the catalogue, in the masthead (science.css `.masthead nav`). Repositories:
// the GitHub side (night phase 01), the reader's own repositories and how to create or link one.
const sections = [
  { text: "Search", href: "/search/" },
  { text: "Browse", href: "/browse/" },
  { text: "DOI lookup", href: "/lookup/" },
  { text: "Repositories", href: "/repositories/" },
  // Night phase 08: discovery, and the reader's in-site notifications (never an email).
  { text: "Explore", href: "/explore/" },
  { text: "Notifications", href: "/notifications/" },
  { text: "Account", href: "/account/" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={SITE_NAME} />
    {/* Night phase 16: Turnstile's public site key, for the forms' human check (src/scripts/human-check.ts). */}
    {TURNSTILE_SITE_KEY && <meta name="turnstile-site-key" content={TURNSTILE_SITE_KEY} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="masthead">
      <div class="inner">
        <a class="site" href="/" title={SITE_TAGLINE === SITE_NAME ? undefined : SITE_TAGLINE}>{SITE_NAME}</a>
        <nav aria-label="Sections">{sections.map((s) => <a href={s.href}>{s.text}</a>)}</nav>
        <form action="/search/" method="get" role="search">
          <input type="search" name="q" placeholder="Search the registry" aria-label="Search the registry" />
          <select name="type" aria-label="What to search">
            <option value="papers">Papers</option>
            <option value="repositories">Repositories</option>
            <option value="issues">Issues</option>
            <option value="people">People</option>
            <option value="topics">Topics</option>
            <option value="commits">Commits</option>
            <option value="code">Code</option>
          </select>
          <select name="field" aria-label="Where to search (papers)">
            <option value="all">All fields</option>
            <option value="title">Title</option>
            <option value="doi">DOI</option>
            <option value="journal">Journal</option>
            <option value="repo">Code repository</option>
          </select>
          <button type="submit">Search</button>
        </form>
      </div>
    </header>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">{SITE_NAME}</a>{breadcrumb.map((b) => (
        <> › {b.href ? <a href={b.href}>{b.text}</a> : b.id ? <span id={b.id}>{b.text}</span> : b.text}</>
      ))}
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <a href="/">Catalogue</a>
      <a href="/browse/">Browse</a>
      <a href="/lookup/">DOI lookup</a>
      <a href="/about/">About</a>
      <a href="/developers/">API</a>
      <a href="https://github.com/yannbellec/Open-Scientific-Code-Registry-OSCR-">GitHub</a>
      {SITE_NAME} · Catalogue of {generatedInWords(catalog.generated_at)}. Each script keeps the license of its
      repository; the source always prevails.
    </footer>
  </body>
</html>
