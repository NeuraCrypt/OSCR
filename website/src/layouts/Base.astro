---
// The main layout. science.css is the ONLY source of style of the site, and it is
// imported here only. The name of the platform comes from src/config.ts, and only
// from there.
import "../styles/science.css";
import { SITE_FULL_NAME, SITE_NAME, SITE_TAGLINE, SOURCE_URL } from "../config";
import { FOOTER, pageExists } from "../lib/info";
import { catalog, generatedInWords } from "../lib/catalog";

interface Props {
  /** The title of the page, without the platform's name (added here). None on the home page. */
  title?: string;
  description?: string;
  /** The breadcrumb after the platform's name; the last item has no link. `id`: a page whose
   *  script renders it names its last item (the pages rendered on demand). */
  breadcrumb?: { text: string; href?: string; id?: string }[];
}
const {
  title,
  description = "The code published by the authors of open-access neuroscience papers: found in the paper, verified at the source.",
  breadcrumb = [],
} = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : SITE_TAGLINE === SITE_NAME ? SITE_NAME : `${SITE_NAME} — ${SITE_TAGLINE}`;
// The ways in besides the catalogue, in the masthead (science.css `.masthead nav`).
const sections = [
  { text: "Search", href: "/search/" },
  { text: "Browse", href: "/browse/" },
  { text: "DOI lookup", href: "/lookup/" },
  { text: "Account", href: "/account/" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={SITE_NAME} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <header class="masthead">
      <div class="inner">
        <a class="site" href="/" title={SITE_TAGLINE === SITE_NAME ? undefined : SITE_TAGLINE}><img
          src="/brand/logo-masthead.png" width="320" height="93" alt={SITE_NAME} /></a>
        <nav aria-label="Sections">{sections.map((s) => <a href={s.href}>{s.text}</a>)}</nav>
        <form action="/search/" method="get" role="search">
          <input type="search" name="q" placeholder="Search the catalogue" aria-label="Search the catalogue" />
          <select name="field" aria-label="Where to search">
            <option value="all">All fields</option>
            <option value="title">Title</option>
            <option value="doi">DOI</option>
            <option value="journal">Journal</option>
            <option value="repo">Code repository</option>
          </select>
          <button type="submit">Search</button>
        </form>
      </div>
    </header>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">{SITE_NAME}</a>{breadcrumb.map((b) => (
        <> › {b.href ? <a href={b.href}>{b.text}</a> : b.id ? <span id={b.id}>{b.text}</span> : b.text}</>
      ))}
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <nav aria-label="About the registry">
        {FOOTER.filter((l) => pageExists(l.href.split("#")[0])).map((l) => <a href={l.href}>{l.text}</a>)}
        <a href={SOURCE_URL}>Source code</a>
      </nav>
      <p>
        {SITE_FULL_NAME} · Catalogue of {generatedInWords(catalog.generated_at)}. Each script keeps the licence of its
        repository; the source always prevails. No email address is ever asked for or shown.
      </p>
    </footer>
  </body>
</html>
