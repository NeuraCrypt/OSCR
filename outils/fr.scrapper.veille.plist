<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  La VEILLE (`scrapper veiller`) : le ramasseur, en continu et en tâche de FOND.
  Ses réglages : ~/.config/scrapper/reglages, lus par Python.
  Gabarit : outils/installer_mac.sh remplace @RACINE@ et @JOURNAUX@.

  launchd lance PYTHON, pas un script shell : macOS refuse à /bin/zsh lancé
  par launchd d'ouvrir un fichier du disque externe (code 127), et laisse
  Python, et ce qu'il lance (git), y lire et écrire (vérifié le 26/09/2026).

  ProcessType (@TYPE@) suit le réglage SCRAPPER_PRIORITE :
  - « fond » donne Background : cœurs d'efficacité, entrées-sorties ET réseau
    bridés. C'est le plus discret, et ~3 fois plus lent (mesuré le 26/09/2026 :
    débit descendant ÷ 3, requêtes plus lentes) ;
  - « normale » donne Standard : le réseau n'est plus bridé, et Nice 15 garde
    le processeur en dernier servi.

  Dans les deux cas, elle attend surtout le réseau : 1,4 % d'un cœur en
  moyenne, 40 à 60 Mo mesurés.

  KeepAlive/PathState : elle tourne tant que le disque Expansion est monté,
  repart seule quand on le rebranche, et après chaque cycle de 24 h.
  ThrottleInterval : 2 minutes au moins entre deux relances.

  Le journal est dans ~/Library/Logs : launchd refuse d'en ouvrir un sur le
  disque externe (la tâche meurt avant de démarrer, code 78, vu le 26/09/2026).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fr.scrapper.veille</string>

  <key>ProgramArguments</key>
  <array>
    <string>@RACINE@/.venv/bin/python</string>
    <string>-m</string>
    <string>scrapper</string>
    <string>--sans-fiches</string>
    <string>veiller</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@RACINE@</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>@RACINE@/.venv/bin/python</key>
      <true/>
    </dict>
  </dict>
  <key>ThrottleInterval</key>
  <integer>120</integer>

  <key>ProcessType</key>
  <string>@TYPE@</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>LowPriorityBackgroundIO</key>
  <true/>
  <key>Nice</key>
  <integer>15</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@JOURNAUX@/veille.log</string>
  <key>StandardErrorPath</key>
  <string>@JOURNAUX@/veille.log</string>
</dict>
</plist>
