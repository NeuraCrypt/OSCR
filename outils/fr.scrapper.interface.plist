<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  L'interface : le tableau de la base sur http://127.0.0.1:8790, pour cette
  machine seulement (rien n'écoute sur le réseau). Un serveur de la
  bibliothèque standard, ~30 Mo, qui ne fait rien tant qu'on ne l'ouvre pas.

  KeepAlive/PathState : il tourne tant que le disque Expansion est monté, et
  repart seul quand on le rebranche.
  Gabarit : outils/installer_mac.sh remplace @RACINE@ et @JOURNAUX@ (le journal
  ne peut pas être sur le disque externe : launchd refuse de l'ouvrir).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fr.scrapper.interface</string>

  <key>ProgramArguments</key>
  <array>
    <string>@RACINE@/.venv/bin/python</string>
    <string>-m</string>
    <string>scrapper</string>
    <string>serveur</string>
    <string>--port</string>
    <string>8790</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@RACINE@</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>@RACINE@/.venv/bin/python</key>
      <true/>
    </dict>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>@JOURNAUX@/interface.log</string>
  <key>StandardErrorPath</key>
  <string>@JOURNAUX@/interface.log</string>
</dict>
</plist>
